{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoinixDR",
  "version": "0.1.0",
  "identifier": "org.phoinixdr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhoinixDR",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "pcoronaf",
    "copyright": "PhoinixDR by @pcoronaf",
    "shortDescription": "Open-source, evidence-driven data recovery",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
